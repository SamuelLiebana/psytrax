__pycache__/
*.pyc
*.egg-info/
dist/
build/
.eggs/
*.npy
# Whitelist per-mouse data files at any depth under data/ (e.g. data/*.npy
# AND data/with_dopamine/*.npy) so they ship with the Streamlit app on
# GitHub-hosted deployments.
!data/**/*.npy
!example_fits/*.npy
fits/
*.ipynb_checkpoints/
.DS_Store
.venv/

# Large raw CSVs — keep out of the repo (multi-GB, distributed separately).
# The per-mouse .npy files derived from them ARE checked in.
data/*.csv
